{
  "name": "@inpost-expander/server",
  "packageManager": "pnpm@10.33.1",
  "type": "module",
  "scripts": {
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "build": "tsc && tsc-alias",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:sync": "dotenv -e ../../.env -- tsx src/sync.ts",
    "db:push": "dotenv -e ../../.env -- npx prisma db push",
    "db:studio": "dotenv -e ../../.env -- npx prisma studio",
    "db:migrate": "dotenv -e ../../.env -- npx prisma migrate dev",
    "db:generate": "dotenv -e ../../.env -- npx prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@inpost-expander/eslint-config": "workspace:*",
    "@inpost-expander/types": "workspace:*",
    "@inpost-expander/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}

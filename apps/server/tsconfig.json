{
  "extends": "@inpost-expander/typescript-config/base-config",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Bundler mode */
    "isolatedModules": true
  },
  "include": ["src/**/*"]
}
